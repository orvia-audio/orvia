<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifdef LabDriver ?>
    <?define ProductName = "Orvia (test driver)" ?>
    <?define Family = "FF4E4F65-2891-4DB8-BDBC-C42D9B179C3B" ?>
    <?define OtherFamily = "3E169810-1163-4F20-B547-F00347D32761" ?>
  <?else?>
    <?define ProductName = "Orvia" ?>
    <?define Family = "3E169810-1163-4F20-B547-F00347D32761" ?>
    <?define OtherFamily = "FF4E4F65-2891-4DB8-BDBC-C42D9B179C3B" ?>
  <?endif?>
  <Package Name="$(var.ProductName) $(var.AppVersion)" Manufacturer="Orvia" Version="$(var.ProductVersion)"
           UpgradeCode="$(var.Family)" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Orvia is already installed." Schedule="afterInstallInitialize" />
    <Upgrade Id="$(var.OtherFamily)">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" OnlyDetect="yes" Property="ORVIA_OTHER_EDITION" />
    </Upgrade>
    <Launch Condition="Installed OR NOT ORVIA_OTHER_EDITION" Message="Uninstall the other edition of Orvia before installing this one. Your microphone settings will be kept." />
    <Property Id="MSIRMSHUTDOWN" Value="1" />
    <Binary Id="SessionActions" SourceFile="$(sys.SOURCEFILEDIR)session.js" />
    <CustomAction Id="RememberOrvia" BinaryRef="SessionActions" JScriptCall="rememberSession" />
    <CustomAction Id="RestoreOrvia" BinaryRef="SessionActions" JScriptCall="resumeSession" Execute="rollback" Impersonate="yes" Return="ignore" />
    <CustomAction Id="ResumeOrvia" BinaryRef="SessionActions" JScriptCall="resumeSession" Execute="commit" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RememberOrvia" Before="InstallValidate" Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT (REMOVE ~= &quot;ALL&quot;)" />
      <Custom Action="RestoreOrvia" After="InstallInitialize" Condition="RestoreOrvia" />
      <Custom Action="ResumeOrvia" Before="InstallFinalize" Condition="ResumeOrvia" />
    </InstallExecuteSequence>
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="Orvia.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="Orvia.ico" />
    <Property Id="ORVIA_WINDOWS_BUILD">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND ORVIA_WINDOWS_BUILD &gt;= 22000)" Message="Orvia requires Windows 11 x64." />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Orvia">
        <Component Id="Settings"><File Id="AppFile" KeyPath="yes" Source="$(var.Bin)\orvia.exe">
          <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="Orvia" Advertise="yes" Icon="Orvia.ico" />
        </File></Component>
        <Component Id="Engine"><File Id="EngineFile" Source="$(var.Bin)\orvia-engine.exe" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
             Name="Orvia" Value="&quot;[#EngineFile]&quot;" Type="string" />
        </Component>
        <Component Id="Notices"><File Source="$(var.Dist)\THIRD-PARTY-NOTICES.txt" /></Component>
        <Component Id="Runtime"><File Source="$(var.Runtime)" /></Component>
        <?ifdef LabDriver ?>
        <Directory Id="DriverFolder" Name="driver">
          <Component Id="DeviceSetup"><File Id="Helper" Source="$(var.Work)\orvia-device.exe" /></Component>
          <Component Id="DriverInf"><File Source="$(var.Driver)\OrviaAudio.inf" /></Component>
          <Component Id="DriverSys"><File Source="$(var.Driver)\OrviaAudio.sys" /></Component>
          <Component Id="DriverCat"><File Source="$(var.Driver)\OrviaAudio.cat" /></Component>
        </Directory>
        <?endif?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Product" Title="Orvia" Level="1">
      <ComponentRef Id="Settings" /><ComponentRef Id="Engine" /><ComponentRef Id="Notices" /><ComponentRef Id="Runtime" />
      <?ifdef LabDriver ?>
        <ComponentRef Id="DeviceSetup" /><ComponentRef Id="DriverInf" /><ComponentRef Id="DriverSys" /><ComponentRef Id="DriverCat" />
      <?endif?>
    </Feature>
    <?ifdef LabDriver ?>
    <CustomAction Id="InstallDevice" FileRef="Helper" ExeCommand="install" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UndoNewDevice" FileRef="Helper" ExeCommand="remove" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveDevice" FileRef="Helper" ExeCommand="remove" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RestoreDevice" FileRef="Helper" ExeCommand="install" Execute="rollback" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UndoNewDevice" After="InstallFiles" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="InstallDevice" After="UndoNewDevice" Condition="NOT (REMOVE ~= &quot;ALL&quot;)" />
      <Custom Action="RestoreDevice" Before="RemoveDevice" Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveDevice" Before="RemoveFiles" Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <?endif?>
  </Package>
</Wix>
